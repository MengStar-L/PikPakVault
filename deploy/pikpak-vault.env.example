VAULT_LISTEN=0.0.0.0:5675
# Set true when accessing the service exclusively through HTTPS.
VAULT_SECURE_COOKIES=false
# Managed aria2 and downloads default to directories next to the vault binary.
# Custom paths also require matching systemd write permissions.
# VAULT_PROGRAM_DIR=/opt/pikpakvalue
TZ=Asia/Shanghai
# Public release source (owner/repository). Keep this root-owned file trusted.
VAULT_UPDATE_REPOSITORY=MengStar-L/PikPakVault
# Override when using a custom listening address or a local reverse proxy.
# VAULT_HEALTH_URL=http://127.0.0.1:5675/healthz
